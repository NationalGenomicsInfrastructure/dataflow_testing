# SLURM accounting database daemon (slurmdbd) for the dataflow-testing
# stack. Real HPCs run slurmctld + slurmdbd + a database; without
# accounting storage, sacct is disabled - and Yggdrasil's
# SlurmJobManager polls sacct for job state.
#
# Pairs with deploy/Dockerfile.slurm-ctld / .slurmd (same Debian trixie
# SLURM version, same munge layout and shared key volume) and the
# slurmdbd-db compose service (MariaDB backend).
#
# Built by docker compose (service "slurmdbd").

FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends slurmdbd slurm-client munge \
    && rm -rf /var/lib/apt/lists/* \
    # Same root-owned munge layout the other SLURM images use (munged
    # 0.5.16 requires it; see deploy/Dockerfile.slurm-ctld).
    && chown root:root /etc/munge && chmod 755 /etc/munge \
    && chown root:root /var/log/munge && chmod 700 /var/log/munge \
    && chown root:root /var/lib/munge && chmod 755 /var/lib/munge

# Shared cluster config + the slurmdbd config (both in deploy/slurm/).
# slurmdbd.conf must be 0600 and owned by SlurmUser (the daemon refuses
# group/other access or a non-SlurmUser owner).
COPY deploy/slurm/slurm.conf /etc/slurm/slurm.conf
COPY deploy/slurm/slurmdbd.conf /etc/slurm/slurmdbd.conf
RUN chown slurm:slurm /etc/slurm/slurmdbd.conf && chmod 600 /etc/slurm/slurmdbd.conf

COPY deploy/slurm/entrypoint-slurmdbd.sh /usr/local/bin/
COPY deploy/slurm/bootstrap-slurmdbd.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/entrypoint-slurmdbd.sh /usr/local/bin/bootstrap-slurmdbd.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-slurmdbd.sh"]