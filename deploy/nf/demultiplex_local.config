/*
Resource override for running nf-core/demultiplex on the TINY test flowcells
in this repo (Makefile target compose-demux-test).

The pipeline defaults (conf/base.config) assume HPC-sized runs:
BCLCONVERT is labelled process_high (72 GB), FASTP process_medium
(36 GB), everything else process_single (6 GB). Those values are fine
for real flowcells and far too big for a laptop running the test data.

Load with: nextflow run ... -c deploy/nf/demultiplex_local.config
Do NOT use this config for real data.
*/

docker {
    // BCLCONVERT (DRAGEN) opens the hundreds of per-lane BCL files
    // (.cbcl/.filter/.slocs) concurrently via async I/O. Docker's default
    // soft nofile limit for containers is 1024; when I/O is slow (e.g. the
    // first run right after a stack restart, with a cold page cache) the
    // number of concurrent opens can exceed that, open() fails with
    // EMFILE/EBADF and bcl-convert aborts (exit 134) claiming files such as
    // 'L001/C8.1/L001_2.cbcl' are "Missing" - although they are present.
    // Raising the limit makes the file table inexhaustible for this workload.
    //
    // NOTE: a -c config value replaces the profile's value instead of
    // merging with it, so the docker profile's '-u $(id -u):$(id -g)'
    // (lets the container write output owned by the host user) is repeated
    // here. The expansion happens at task-run time in the .command.run
    // wrapper, as usual.
    runOptions = '-u $(id -u):$(id -g) --ulimit nofile=65535:65535'
}

process {
    withLabel:process_single {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'
    }
    withLabel:process_medium {
        cpus   = 2
        memory = '4 GB'
        time   = '1h'
    }
    withLabel:process_high {
        cpus   = 2
        memory = '6 GB'
        time   = '2h'
    }
}