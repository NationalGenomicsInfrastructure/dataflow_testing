# The yggdrasil image for the compose stack: the base image plus a JVM, a
# pinned Nextflow launcher, a static Docker CLI client that talks to
# the compose "dind" sidecar (docker:dind), so nf-core pipelines (e.g.
# nf-core/demultiplex) can run with -profile docker (docker-in-docker),
# and the SLURM client (sbatch/sacct) used to submit batch jobs to the
# stack's local single-node SLURM cluster (slurmctld/slurmd services).
#
# Build order (see Makefile target `compose-build-yggdrasil`):
#   docker build -f deploy/Dockerfile.yggdrasil      -t dataflow-yggdrasil:latest       .
#   docker build -f deploy/Dockerfile.yggdrasil.dind -t dataflow-yggdrasil-dind:latest  .

FROM dataflow-yggdrasil:latest

ARG NEXTFLOW_VERSION=26.10.0
ARG DOCKER_CLI_VERSION=27.5.1

ENV NEXTFLOW_HOME=/opt/nf_home \
    DOCKER_HOST=tcp://dind:2375 \
    PATH=/opt/nextflow:$PATH

# JVM (Nextflow) + git (pipeline pulls) + static Docker CLI (client for
# the DinD sidecar daemon; pinned for reproducibility, arch-aware).
# Trixie base image: openjdk-17 is gone, use 21.
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-21-jre-headless git \
    && rm -rf /var/lib/apt/lists/* \
    && case "${TARGETARCH:-amd64}" in aarch64) arch=aarch64 ;; *) arch=x86_64 ;; esac \
    && curl -fsSL -o /tmp/docker.tgz \
        "https://download.docker.com/linux/static/stable/${arch}/docker-${DOCKER_CLI_VERSION}.tgz" \
    && tar xzf /tmp/docker.tgz -C /tmp \
    && install -m 0755 /tmp/docker/docker /usr/local/bin/docker \
    && rm -rf /tmp/docker /tmp/docker.tgz \
    && docker --version

# Pinned Nextflow launcher (deterministic, no install-script surprises).
RUN mkdir -p /opt/nextflow /opt/nf_home \
    && curl -fsSL -o /opt/nextflow/nextflow \
        "https://github.com/nextflow-io/nextflow/releases/download/v${NEXTFLOW_VERSION}/nextflow" \
    && chmod +x /opt/nextflow/nextflow \
    && nextflow -version

# SLURM client for the local cluster (slurmctld/slurmd compose services,
# deploy/Dockerfile.slurm-ctld / .slurmd). Same Debian trixie package as
# the server images, so client and controller run identical versions.
# munged requires a root-owned munge layout (key root:root 0400 on the
# shared slurm-munge volume, mounted at /etc/munge); the entrypoint
# starts munged at boot (deploy/yggdrasil-entrypoint.sh).
RUN apt-get update \
    && apt-get install -y --no-install-recommends slurm-client slurm-wlm-basic-plugins munge \
    && rm -rf /var/lib/apt/lists/* \
    && chown root:root /etc/munge && chmod 755 /etc/munge \
    && chown root:root /var/log/munge && chmod 700 /var/log/munge \
    && chown root:root /var/lib/munge && chmod 755 /var/lib/munge
COPY deploy/slurm/slurm.conf /etc/slurm/slurm.conf

# Laptop-sized resource overrides for the realm's pipeline runs. The
# entrypoint copies it to /work/demultiplex_local.config on the shared
# volume; the realm config (deploy/yggdrasil-config/dmx_realm.json,
# nextflow.common_config) points at that path.
RUN mkdir -p /etc/demux
COPY deploy/nf/demultiplex_local.config /etc/demux/demultiplex_local.config

# Blocks until the DinD daemon answers (call before the first pipeline run).
RUN printf '%s\n' \
        '#!/bin/sh' \
        'until docker info >/dev/null 2>&1; do echo "waiting for dind daemon..."; sleep 2; done' \
        > /usr/local/bin/wait-for-dind \
    && chmod +x /usr/local/bin/wait-for-dind